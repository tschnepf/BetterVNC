<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterVnc.Agent.Protocol\BetterVnc.Agent.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reader of the macOS capture helper's pipe; compiled in here because the agent itself is an executable. -->
    <Compile Include="..\..\tools\BetterVnc.Agent\Video\CaptureHelperSession.cs" Link="Linked\CaptureHelperSession.cs" />
    <Compile Include="..\..\tools\BetterVnc.Agent\MacAppBundle.cs" Link="Linked\MacAppBundle.cs" />
    <!-- Only its helper command line is tested here; the rest needs a Mac. -->
    <Compile Include="..\..\tools\BetterVnc.Agent\Video\MacScreenSource.cs" Link="Linked\MacScreenSource.cs" />
  </ItemGroup>

</Project>
