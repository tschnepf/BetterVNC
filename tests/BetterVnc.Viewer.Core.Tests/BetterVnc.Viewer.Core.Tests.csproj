<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The viewer core without a GUI: the stream player and the session controller with fake views, a fake clipboard, a
    test UI thread with hand-fired timers, the fake RFB server of the protocol tests and an in-process guest agent.
    Runs on every OS.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterVnc.Viewer.Core\BetterVnc.Viewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A scripted RFB server on loopback, shared with the protocol tests. -->
    <Compile Include="..\BetterVnc.Protocol.Tests\FakeRfbServer.cs" Link="Linked\FakeRfbServer.cs" />
  </ItemGroup>

</Project>
