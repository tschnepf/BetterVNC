#!/bin/sh
# Runs as root at the end of the package install. Picks the build for this CPU, exposes it on the PATH and sets the
# agent up for the person who is signed in, through the agent's own "install" command (per-user copy in
# ~/Library/Application Support/BetterVNC, LaunchAgent, started now). Never fails the package: a missing signed-in
# user only means "install" has to be run later.
base="/usr/local/libexec/bettervnc-agent"
case "$(uname -m)" in
  arm64) arch=arm64 ;;
  *)     arch=x64 ;;
esac
bin="$base/$arch/bettervnc-agent"
chmod 755 "$base/arm64/bettervnc-agent" "$base/x64/bettervnc-agent" "$base/uninstall.sh" 2>/dev/null || true
mkdir -p /usr/local/bin
ln -sfn "$bin" /usr/local/bin/bettervnc-agent

user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -z "$user" ] || [ "$user" = "root" ] || [ "$user" = "loginwindow" ] || [ "$user" = "_mbsetupuser" ]; then
  echo "bettervnc-agent: nobody is signed in; run 'bettervnc-agent install' in Terminal when you are."
  exit 0
fi
uid="$(id -u "$user")"
echo "bettervnc-agent: setting up for $user"
if ! launchctl asuser "$uid" sudo -u "$user" "$bin" install; then
  echo "bettervnc-agent: automatic setup did not finish; run 'bettervnc-agent install' in Terminal as $user."
fi
exit 0
