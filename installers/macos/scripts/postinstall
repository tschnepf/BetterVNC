#!/bin/sh
# Runs as root at the end of the package install. Exposes the agent on the PATH and sets it up for the person who is
# signed in, through the agent's own "install" command: it leaves the app in /Applications as it is, removes every
# other installed copy (the C# agent's ~/Library/Application Support/BetterVNC/BetterVNC Agent.app of v0.0.4 and
# earlier among them), keeps the config with the pairings and token, points the LaunchAgent at /Applications and
# starts it. Never fails the package: a missing signed-in user only means "install" has to be run later.
app="/Applications/BetterVNC Agent.app"
bin="$app/Contents/MacOS/bettervnc-agent"

# Packages before the native app put the C# agent under /usr/local/libexec/bettervnc-agent/<arch>.
rm -rf /usr/local/libexec/bettervnc-agent/arm64 /usr/local/libexec/bettervnc-agent/x64
mkdir -p /usr/local/bin
ln -sfn "$bin" /usr/local/bin/bettervnc-agent

user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -z "$user" ] || [ "$user" = "root" ] || [ "$user" = "loginwindow" ] || [ "$user" = "_mbsetupuser" ]; then
  echo "bettervnc-agent: nobody is signed in; run 'bettervnc-agent install' in Terminal when you are."
  exit 0
fi
uid="$(id -u "$user")"
echo "bettervnc-agent: setting up for $user"
# -H: the user's own home, where the config, the LaunchAgent and the old agent are.
if ! launchctl asuser "$uid" sudo -H -u "$user" "$bin" install; then
  echo "bettervnc-agent: automatic setup did not finish; run 'bettervnc-agent install' in Terminal as $user."
fi
exit 0
