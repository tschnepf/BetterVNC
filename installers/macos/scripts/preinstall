#!/bin/sh
# Runs as root before the package's files are laid down. Stops the agent of the person who is signed in (the C# agent
# of v0.0.4 and earlier, or this app), so launchd does not restart a copy while its files are being replaced;
# postinstall sets it up and starts it again. Never fails the package.
user="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ] && [ "$user" != "_mbsetupuser" ]; then
  launchctl bootout "gui/$(id -u "$user")/com.bettervnc.agent" 2>/dev/null || true
fi
exit 0
