<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the application icon from the geometry in Program.cs:
      src/BetterVnc.App/Assets/BetterVNC.ico   (16..256 px, embedded in BetterVNC.exe)
      src/BetterVnc.App/Assets/icon.svg        (master vector)
      docs/icon.png                            (256 px preview for the README)

    Run from the repository root:
      dotnet build tools/BetterVnc.IconGen
      dotnet tools/BetterVnc.IconGen/bin/Debug/net10.0-windows/BetterVnc.IconGen.dll
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterVnc.IconGen</RootNamespace>
  </PropertyGroup>

</Project>
