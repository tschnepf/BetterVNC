<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The BetterVNC guest agent for Windows and Linux: runs inside the VM and gives the viewer a rich clipboard
    (images, files, HTML) that RFB cannot carry. The macOS agent is a native app, tools/BetterVnc.Agent.Mac.

    Two target frameworks: net10.0-windows (Windows Forms clipboard, SendInput scrolling) for the Windows build,
    plain net10.0 (xclip / wl-clipboard; xdotool or ydotool scrolling) for Linux. The plain build also runs the 'probe'
    test client on any OS.

    Publish (single file, self-contained):
      dotnet publish tools/BetterVnc.Agent -c Release -f net10.0-windows -r win-x64   -o publish/agent-win-x64
      dotnet publish tools/BetterVnc.Agent -c Release -f net10.0         -r linux-x64 -o publish/agent-linux-x64
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BetterVnc.Agent</RootNamespace>
    <AssemblyName>bettervnc-agent</AssemblyName>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>Major</RollForward>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Building (not publishing) should not need a runtime identifier. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pointers into captured frames (H264ScreenSession). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      GUI subsystem, so starting at sign-in opens no console window and needs no hidden launcher. Commands run from a
      terminal attach to its console (Program.AttachToParentConsole).
    -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Tray and dialog icon, shared with the viewer. -->
    <EmbeddedResource Include="..\..\src\BetterVnc.App\Assets\BetterVNC.ico" Link="Assets\BetterVNC.ico" LogicalName="BetterVNC.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Input\WindowsInput.cs" />
    <Compile Remove="Video\WindowsScreenSource.cs" />
    <Compile Remove="Video\H264ScreenSession.cs" />
    <Compile Remove="Pairing\WindowsApprover.cs" />
    <Compile Remove="Tray\TrayApp.cs" />
    <Compile Remove="Tray\SettingsForm.cs" />
    <Compile Remove="Tray\TrayIcon.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterVnc.Agent.Protocol\BetterVnc.Agent.Protocol.csproj" />
    <!-- The clipboards (Windows Forms, xclip / wl-clipboard), shared with the viewer. -->
    <ProjectReference Include="..\..\src\BetterVnc.Platform\BetterVnc.Platform.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Media Foundation H.264 encoder and Desktop Duplication capture for the screen stream. -->
    <ProjectReference Include="..\..\src\BetterVnc.Media.Windows\BetterVnc.Media.Windows.csproj" />
  </ItemGroup>

</Project>
