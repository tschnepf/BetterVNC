<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plays a pre-encoded H.264 stream into the viewer's real VncView at a fixed rate and measures what the viewer
    process spends on it, for each way a frame can reach the screen (software decode + CPU conversion + WPF, the
    path before GPU presentation; DXVA + swap chain; software decode + swap chain). Also checks on screen that the
    picture switches to the RFB framebuffer and back, as the stream's idle fallback does. Dev tool, not shipped.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BetterVnc.StreamBench</RootNamespace>
    <ApplicationManifest>..\..\src\BetterVnc.App\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterVnc.App\BetterVnc.App.csproj" />
    <ProjectReference Include="..\..\src\BetterVnc.Media\BetterVnc.Media.csproj" />
    <ProjectReference Include="..\..\src\BetterVnc.Protocol\BetterVnc.Protocol.csproj" />
  </ItemGroup>

</Project>
