<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The portable half of the media plumbing, shared by the viewer and the guest agent on every OS: the SIMD BGRA/NV12
    conversions, Annex B parsing, dirty regions, the stream's frame-rate governor, video placement, and the decoded
    picture and decoder shapes each OS's video backend implements. Plain C#, no native code. The Windows backend
    (Media Foundation, Direct3D 11, Desktop Duplication) is BetterVnc.Media.Windows.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BetterVnc.Media</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests run each SIMD path of the BGRA to NV12 conversion against the scalar one. -->
    <InternalsVisibleTo Include="BetterVnc.Media.Tests" />
  </ItemGroup>

</Project>
