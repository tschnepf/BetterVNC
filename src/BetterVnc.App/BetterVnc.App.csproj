<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BetterVNC</AssemblyName>
    <RootNamespace>BetterVnc.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterVNC.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterVnc.Protocol\BetterVnc.Protocol.csproj" />
    <ProjectReference Include="..\BetterVnc.Agent.Protocol\BetterVnc.Agent.Protocol.csproj" />
    <ProjectReference Include="..\BetterVnc.Media.Windows\BetterVnc.Media.Windows.csproj" />
    <!-- Everything that is not WPF: profiles, agent client, stream player, session controller. -->
    <ProjectReference Include="..\BetterVnc.Viewer.Core\BetterVnc.Viewer.Core.csproj" />
    <!-- The Windows clipboard and DPAPI, shared with the agent. -->
    <ProjectReference Include="..\BetterVnc.Platform\BetterVnc.Platform.csproj" />
  </ItemGroup>

</Project>
