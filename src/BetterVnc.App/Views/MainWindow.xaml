<Window x:Class="BetterVnc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterVNC" Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Connections -->
        <DockPanel Grid.Column="0" Margin="20,16,10,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="New connection" Style="{StaticResource PrimaryButton}" Click="OnNewConnection" />
                <Button DockPanel.Dock="Right" x:Name="DisconnectAllButton" Content="Disconnect all" Margin="0,0,8,0" Visibility="Collapsed"
                        ToolTip="Close every open session window" Click="OnDisconnectAll" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Connections" />
                    <TextBlock Style="{StaticResource Muted}" Text="Double-click to connect. Right-click for more." />
                </StackPanel>
            </DockPanel>
            <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,0,0,12" TextChanged="OnSearchChanged" ToolTip="Filter connections" />
            <TextBlock DockPanel.Dock="Top" x:Name="EmptyHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="No connections yet. Add an Unraid server on the right to discover its VMs, or create a connection to any VNC server or Mac." />
            <ListBox x:Name="ConnectionList" MouseDoubleClick="OnConnectionDoubleClick" KeyDown="OnConnectionKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" />
                            </Border>
                            <!-- Session badge: shown while a session window is open for this connection -->
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{StaticResource PanelBrush}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SessionBadge}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Connect" Click="OnConnectMenu" />
                        <MenuItem Header="Connect fullscreen" Click="OnConnectFullscreenMenu" />
                        <MenuItem Header="Open another session" Click="OnOpenAnotherSessionMenu"
                                  ToolTip="Open a second window to this connection even though one is already open" />
                        <Separator />
                        <MenuItem Header="Edit…" Click="OnEditMenu" />
                        <MenuItem Header="Duplicate" Click="OnDuplicateMenu" />
                        <MenuItem Header="Delete" Click="OnDeleteMenu" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- Unraid servers -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Heading}" Text="Unraid servers" FontSize="16" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Discover VMs, read their VNC port and password, and start them, all over SSH." />
                </StackPanel>
                <Button DockPanel.Dock="Top" Content="Add Unraid server" Click="OnAddServer" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                <ListBox x:Name="ServerList" MouseDoubleClick="OnServerDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="VMs" Click="OnBrowseServer" VerticalAlignment="Center" Padding="8,3" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Browse VMs…" Click="OnBrowseServerMenu" />
                            <MenuItem Header="Edit…" Click="OnEditServerMenu" />
                            <MenuItem Header="Delete" Click="OnDeleteServerMenu" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
