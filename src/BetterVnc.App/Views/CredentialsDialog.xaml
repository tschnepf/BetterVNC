<Window x:Class="BetterVnc.App.Views.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Label x:Name="UserLabel" Content="User name" />
        <TextBox x:Name="UserBox" Margin="0,0,0,8" />
        <Label Content="Password" />
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />
        <CheckBox x:Name="RememberBox" Content="Remember for this connection" IsChecked="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Connect" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
