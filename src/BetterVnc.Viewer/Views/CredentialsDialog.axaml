<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BetterVnc.Viewer.Views.CredentialsDialog"
        Title="Sign in" Width="380" SizeToContent="Height" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/BetterVNC.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Label x:Name="UserLabel" Content="User name" />
        <TextBox x:Name="UserBox" Margin="0,0,0,8" />
        <Label Content="Password" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" Margin="0,0,0,8" />
        <CheckBox x:Name="RememberBox" Content="Remember for this connection" IsChecked="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConnectButton" Content="Connect" Theme="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
