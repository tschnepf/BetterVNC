<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:BetterVnc.Viewer.Views"
        x:Class="BetterVnc.Viewer.Views.UnraidServerWindow"
        Title="Unraid server" Width="720" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/BetterVNC.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" />
                    <Button x:Name="SaveButton" Content="Save" Theme="{StaticResource PrimaryButton}" Click="OnSave" MinWidth="90" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Classes="Muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Grid Margin="20,12,20,12" RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0">
                <TextBlock Classes="SectionLabel" Text="SSH ACCESS" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="110,*,110,*" RowDefinitions="Auto,Auto,Auto">
                    <Label Grid.Row="0" Content="Name" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3,12,3" />
                    <Label Grid.Row="0" Grid.Column="2" Content="Host" />
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="HostBox" Margin="0,3" />
                    <Label Grid.Row="1" Content="User" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserBox" Margin="0,3,12,3" />
                    <Label Grid.Row="1" Grid.Column="2" Content="SSH port" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="PortBox" Margin="0,3" Width="90" HorizontalAlignment="Left" />
                    <Label Grid.Row="2" Content="Password" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" PasswordChar="●" Margin="0,3,12,3" />
                    <Label Grid.Row="2" Grid.Column="2" Content="Private key" />
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="KeyBox" Margin="0,3" ToolTip.Tip="Optional OpenSSH private key path" />
                </Grid>
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,12,0,6">
                <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Load VMs" Click="OnRefresh" />
                <TextBlock Classes="SectionLabel" Text="VIRTUAL MACHINES" VerticalAlignment="Center" Margin="0" />
            </DockPanel>

            <ListBox Grid.Row="2" x:Name="VmList" DoubleTapped="OnVmDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="v:VmRow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <Button Content="Start" Click="OnStartVm" IsVisible="{Binding CanStart}" />
                                <Button Content="Connect" Theme="{StaticResource PrimaryButton}" Click="OnConnectVm" IsVisible="{Binding CanConnect}" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Classes="dot" Classes.connected="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Classes="Muted" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Warnings}" Classes="Muted" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="16,2,0,0"
                                           IsVisible="{Binding HasWarnings}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
