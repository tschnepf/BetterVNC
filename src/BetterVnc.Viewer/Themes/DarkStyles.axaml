<!-- The text styles and window defaults of the WPF viewer's Themes/Dark.xaml, as Avalonia style classes. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.Muted">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.Heading">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.SectionLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style Selector="TextBlock.connected">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!-- State dots: grey, green while connected or running -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="Ellipse.dot.connected">
        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style Selector="Label">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Padding" Value="0,4,8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Fluent's 32 px rows are roomier than the WPF viewer's -->
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="0,1,12,1" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="Border.Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The reason a picture mode is greyed out sits in its tooltip, so tooltips show on disabled items. -->
    <Style Selector="ComboBoxItem">
        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
</Styles>
