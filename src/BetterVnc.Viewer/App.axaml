<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BetterVnc.Viewer.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BetterVNC/Themes/Dark.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FF4F8CFF" RegionColor="#FF14161A" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://BetterVNC/Themes/DarkStyles.axaml" />
    </Application.Styles>
</Application>
