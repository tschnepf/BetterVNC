<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything of the viewer that is not UI, for every OS: the profiles and their store, the guest agent client, the
    stream player, the Unraid and file transfer services, and the session controller behind the session window.
    UI frameworks and OS services come in through interfaces (IUiThread, ISessionView, IVideoSurface, and the
    BetterVnc.Platform ones), so the WPF viewer today and an Avalonia one later sit on the same code.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BetterVnc.Viewer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterVnc.Protocol\BetterVnc.Protocol.csproj" />
    <ProjectReference Include="..\BetterVnc.Agent.Protocol\BetterVnc.Agent.Protocol.csproj" />
    <ProjectReference Include="..\BetterVnc.Media\BetterVnc.Media.csproj" />
    <ProjectReference Include="..\BetterVnc.Platform\BetterVnc.Platform.csproj" />
  </ItemGroup>

</Project>
